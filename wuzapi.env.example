# WuzAPI Configuration
# Copy this to wuzapi.env and fill in your own secrets
WUZAPI_PORT=8080
WUZAPI_ADDRESS=0.0.0.0
WUZAPI_ADMIN_TOKEN=my-admin-secret-token
WUZAPI_GLOBAL_ENCRYPTION_KEY=12345678901234567890123456789012
WUZAPI_GLOBAL_HMAC_KEY=my_hmac_key_32_chars_minimum_12345
WUZAPI_GLOBAL_WEBHOOK=http://relay:3100/webhook
WEBHOOK_FORMAT=json
SESSION_DEVICE_NAME=WuzAPI_Fotan
TZ=Asia/Hong_Kong
